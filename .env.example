# Copy to .env for local Docker Compose. Never commit real credentials.
MSSQL_SA_PASSWORD=ReplaceThisWithA_StrongLocalPassword1!
JWT_SECRET_KEY=ReplaceWithAUniqueRandomSecretAtLeast32BytesLong

# Optional bootstrap endpoint secrets (keep private and set only if using bootstrap).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SECRET=
